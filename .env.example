# Public application origin
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Generate with: openssl rand -base64 32 (32 decoded bytes)
NEXUS_MASTER_KEY=replace-with-a-base64-encoded-32-byte-key
# Generate independently with: openssl rand -base64 32 (32+ decoded bytes).
# Keep this backup-authentication key outside backup bundles and separate from storage-encryption keys.
NEXUS_BACKUP_SIGNING_KEY=replace-with-a-separate-base64-encoded-32-byte-key
NEXUS_DATABASE_PATH=./data/nexus.db
# Local content-addressed storage. Must be absolute in production.
NEXUS_ARTIFACT_ROOT=./data/artifacts
# Logical per-owner quota in bytes (default: 1 GiB; each upload is capped at 10 MiB).
NEXUS_ARTIFACT_QUOTA_BYTES=1073741824
# Required only when creating the one owner account.
NEXUS_BOOTSTRAP_TOKEN=replace-with-a-one-time-random-bootstrap-token

# Hosted provider API keys are entered through Provider Connections and encrypted in SQLite.
# Local Ollama is configured by the deployment operator.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional GitHub integration. Prefer a short-lived GitHub App installation token.
GITHUB_TOKEN=

# Optional general web search. Direct URL, RSS, Hacker News, and GitHub research work without it.
TAVILY_API_KEY=
