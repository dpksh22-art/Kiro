{
  "name": "nexus-ai-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A secure, persistent multi-model AI workspace and agent operating system.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:production": "npm run db:migrate && HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:production": "playwright test --config=playwright.production.config.ts",
    "test:persistence": "tsx scripts/production-persistence-smoke.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "backup": "tsx scripts/backup.ts",
    "restore:verify": "tsx scripts/restore-verify.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "better-auth": "1.7.14",
    "better-sqlite3": "13.0.3",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.11.2",
    "ipaddr.js": "^2.3.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.20.6",
    "undici": "^7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.3",
    "eslint-config-next": "16.4.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
